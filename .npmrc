# Speed up `npm install` and keep it deterministic.
# See: https://docs.npmjs.com/cli/v11/using-npm/config

# Skip the network round-trip to the npm audit API on every install.
# Run `npm audit` explicitly (e.g. in CI) instead of paying for it on every install.
audit=false

# Skip the "please fund" nag lookup/printing.
fund=false

# Use the local cache instead of hitting the registry when the cache already
# has a satisfying version — falls back to the network automatically.
prefer-offline=true

# Quieter, slightly faster output (no progress bar re-renders).
progress=false
loglevel=warn
