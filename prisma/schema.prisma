generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomType {
  PRIVATE_OFFICE
  PRIVATE_CABIN
  CONFERENCE_ROOM
  MEETING_ROOM
  DEDICATED_DESK
  HOT_DESK
  TRAINING_ROOM
  EVENT_SPACE
  OPEN_WORKSPACE
  RECEPTION
  OTHER
}

enum RoomStatus {
  AVAILABLE
  PRE_BOOKING
  COMING_SOON
  OCCUPIED
  INACTIVE
}

enum PricingPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum DurationUnit {
  DAYS
  MONTHS
  YEARS
}

model Location {
  id         String   @id @default(uuid())
  name       String
  address    String?
  city       String?
  country    String?
  postalCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  buildings Building[]
  rooms     Room[]
}

model Building {
  id         String   @id @default(uuid())
  name       String
  code       String?  @unique
  locationId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  floors   Floor[]
  rooms    Room[]

  @@index([locationId])
}

model Floor {
  id          String   @id @default(uuid())
  name        String
  floorNumber Int
  buildingId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@unique([buildingId, floorNumber])
  @@index([buildingId])
}

model Room {
  id                  String     @id @default(uuid())
  code                String     @unique
  name                String
  slug                String     @unique
  description         String?
  roomType            RoomType
  status              RoomStatus @default(AVAILABLE)
  capacity            Int        @default(0)
  availableSeats      Int        @default(0)
  locationId          String?
  buildingId          String?
  floorId             String?
  availableFrom       DateTime?
  isPreBookingEnabled Boolean    @default(false)
  backgroundImageUrl  String?
  thumbnailImageUrl   String?
  displayOrder        Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  location     Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  building     Building?          @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor        Floor?             @relation(fields: [floorId], references: [id], onDelete: SetNull)
  amenities    RoomAmenity[]
  pricing      RoomPricing[]
  availability RoomAvailability[]

  @@index([locationId])
  @@index([buildingId])
  @@index([floorId])
  @@index([status, displayOrder])
}

model Amenity {
  id        String   @id @default(uuid())
  name      String   @unique
  iconKey   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms RoomAmenity[]
}

model RoomAmenity {
  roomId    String
  amenityId String

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
  @@index([amenityId])
}

model PricingPlan {
  id          String        @id @default(uuid())
  name        String        @unique
  period      PricingPeriod
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  roomPricing RoomPricing[]
}

model RoomPricing {
  id              String    @id @default(uuid())
  roomId          String
  pricingPlanId   String
  regularPrice    Decimal   @db.Decimal(12, 2)
  offerPrice      Decimal?  @db.Decimal(12, 2)
  preBookingPrice Decimal?  @db.Decimal(12, 2)
  currency        String    @default("INR")
  effectiveFrom   DateTime?
  effectiveUntil  DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  pricingPlan PricingPlan @relation(fields: [pricingPlanId], references: [id], onDelete: Restrict)

  @@index([roomId, isActive])
  @@index([pricingPlanId])
}

model PassPlan {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  duration     Int?
  durationUnit DurationUnit?
  price        Decimal?      @db.Decimal(12, 2)
  currency     String        @default("INR")
  validFrom    DateTime?
  validUntil   DateTime?
  isActive     Boolean       @default(false)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model RoomAvailability {
  id             String     @id @default(uuid())
  roomId         String
  status         RoomStatus
  availableSeats Int
  validFrom      DateTime?
  validUntil     DateTime?
  note           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, validFrom])
}
